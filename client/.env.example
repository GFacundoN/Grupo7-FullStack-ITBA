# Copiar como client/.env y ajustar segun el entorno.
# URL base de la API, SIN barra final, CON /api. La usa services/productosApi.js.

# En local (backend corriendo con npm start en /backend):
VITE_API_URL=http://localhost:5000/api

# En produccion: la URL del backend desplegado en Render + /api, por ejemplo
# VITE_API_URL=https://hermanos-jota-api.onrender.com/api
