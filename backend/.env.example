# Copiar este archivo como backend/.env y completar la URI de MongoDB Atlas.
# Reemplazar los marcadores y codificar los caracteres especiales de la clave.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>/hermanos_jota?retryWrites=true&w=majority

# Puerto HTTP opcional (el servidor actual usa 5000 por defecto).
PORT=5000

# La conexion usa explicitamente la base hermanos_jota y la coleccion products.
