# Copiar este archivo como backend/.env y completar la URI de MongoDB Atlas.
# Reemplazar los marcadores y codificar los caracteres especiales de la clave.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>/hermanos_jota?retryWrites=true&w=majority

# Puerto HTTP opcional (por defecto 5000; Render define PORT solo).
PORT=5000

# URL del frontend permitida por CORS (varias, separadas por coma).
# En produccion: la URL publicada en Vercel/Netlify.
CORS_ORIGIN=http://localhost:5173

# Generar una clave aleatoria de al menos 32 bytes para cada entorno.
# No usar este marcador como clave ni compartir el valor real.
JWT_SECRET=<generar-clave-aleatoria-de-al-menos-32-bytes>
JWT_EXPIRES_IN=24h

# La conexion usa explicitamente la base hermanos_jota y la coleccion products.
